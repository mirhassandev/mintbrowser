<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens: colours. Monochrome: Obsidian #222222, Steely Ice #929292, Glacier Gray #D1D1D1, Frosted White #FAFAFA. Accent = Frosted White, hairline separators.
         Key names are stable: changing a value here re-skins every view that uses the token. -->

    <!-- Surfaces: three elevations of the same neutral -->
    <Color x:Key="MintSurfaceColor">#222222</Color>
    <Color x:Key="MintSurfaceRaisedColor">#2E2E2E</Color>
    <Color x:Key="MintSurfaceInputColor">#2A2A2A</Color>
    <Color x:Key="MintSurfaceFieldColor">#181818</Color>

    <!-- Borders: hairlines, not outlines -->
    <Color x:Key="MintBorderColor">#3C3C3C</Color>
    <Color x:Key="MintBorderStrongColor">#505050</Color>
    <Color x:Key="MintSeparatorColor">#1FFFFFFF</Color>

    <!-- Text: primary, secondary, tertiary -->
    <Color x:Key="MintTextColor">#FAFAFA</Color>
    <Color x:Key="MintTextSoftColor">#D1D1D1</Color>
    <Color x:Key="MintTextMutedColor">#929292</Color>
    <Color x:Key="MintTextTertiaryColor">#6B6B6B</Color>
    <Color x:Key="MintTextOnAccentColor">#222222</Color>

    <!-- Accent and status -->
    <Color x:Key="MintAccentColor">#FAFAFA</Color>
    <Color x:Key="MintAccentHoverColor">#FFFFFF</Color>
    <Color x:Key="MintAccentPressedColor">#B8B8B8</Color>
    <Color x:Key="MintAccentSoftColor">#1FFAFAFA</Color>
    <Color x:Key="MintAccentSecondaryColor">#D1D1D1</Color>
    <Color x:Key="MintAccentSecondaryHoverColor">#E6E6E6</Color>
    <Color x:Key="MintDangerColor">#FF6961</Color>
    <Color x:Key="MintWarningColor">#FFB340</Color>
    <Color x:Key="MintSuccessColor">#32D74B</Color>

    <!-- Interaction overlays -->
    <Color x:Key="MintHoverOverlayColor">#14FFFFFF</Color>
    <Color x:Key="MintPressOverlayColor">#24FFFFFF</Color>
    <Color x:Key="MintSelectedOverlayColor">#1FFFFFFF</Color>

    <SolidColorBrush x:Key="MintSurfaceBrush" Color="{StaticResource MintSurfaceColor}"/>
    <SolidColorBrush x:Key="MintSurfaceRaisedBrush" Color="{StaticResource MintSurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="MintSurfaceInputBrush" Color="{StaticResource MintSurfaceInputColor}"/>
    <SolidColorBrush x:Key="MintSurfaceFieldBrush" Color="{StaticResource MintSurfaceFieldColor}"/>
    <SolidColorBrush x:Key="MintBorderBrush" Color="{StaticResource MintBorderColor}"/>
    <SolidColorBrush x:Key="MintBorderStrongBrush" Color="{StaticResource MintBorderStrongColor}"/>
    <SolidColorBrush x:Key="MintSeparatorBrush" Color="{StaticResource MintSeparatorColor}"/>
    <SolidColorBrush x:Key="MintTextBrush" Color="{StaticResource MintTextColor}"/>
    <SolidColorBrush x:Key="MintTextSoftBrush" Color="{StaticResource MintTextSoftColor}"/>
    <SolidColorBrush x:Key="MintTextMutedBrush" Color="{StaticResource MintTextMutedColor}"/>
    <SolidColorBrush x:Key="MintTextTertiaryBrush" Color="{StaticResource MintTextTertiaryColor}"/>
    <SolidColorBrush x:Key="MintTextOnAccentBrush" Color="{StaticResource MintTextOnAccentColor}"/>
    <SolidColorBrush x:Key="MintAccentBrush" Color="{StaticResource MintAccentColor}"/>
    <SolidColorBrush x:Key="MintAccentHoverBrush" Color="{StaticResource MintAccentHoverColor}"/>
    <SolidColorBrush x:Key="MintAccentPressedBrush" Color="{StaticResource MintAccentPressedColor}"/>
    <SolidColorBrush x:Key="MintAccentSoftBrush" Color="{StaticResource MintAccentSoftColor}"/>
    <SolidColorBrush x:Key="MintDangerBrush" Color="{StaticResource MintDangerColor}"/>
    <SolidColorBrush x:Key="MintWarningBrush" Color="{StaticResource MintWarningColor}"/>
    <SolidColorBrush x:Key="MintSuccessBrush" Color="{StaticResource MintSuccessColor}"/>
    <SolidColorBrush x:Key="MintHoverOverlayBrush" Color="{StaticResource MintHoverOverlayColor}"/>
    <SolidColorBrush x:Key="MintPressOverlayBrush" Color="{StaticResource MintPressOverlayColor}"/>
    <SolidColorBrush x:Key="MintSelectedOverlayBrush" Color="{StaticResource MintSelectedOverlayColor}"/>

    <!-- Depth: a soft scrim behind the chrome, one popup shadow, one accent glow -->
    <LinearGradientBrush x:Key="MintChromeScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#59000000" Offset="0"/>
        <GradientStop Color="#1A000000" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="MintShadowPopup" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.38" Color="Black"/>
    <LinearGradientBrush x:Key="MintAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource MintAccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource MintAccentSecondaryColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MintAccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource MintAccentHoverColor}" Offset="0"/>
        <GradientStop Color="{StaticResource MintAccentSecondaryHoverColor}" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="MintGlowAccent" BlurRadius="12" ShadowDepth="0" Opacity="0.20" Color="#FFFFFF"/>
</ResourceDictionary>


