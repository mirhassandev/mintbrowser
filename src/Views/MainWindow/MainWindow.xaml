<Window x:Class="CustomBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CustomBrowser"
        xmlns:svc="clr-namespace:CustomBrowser.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Mint Browser" Height="850" Width="1300" MinWidth="520" MinHeight="340" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        Background="{StaticResource MintSurfaceBrush}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        WindowState="Maximized"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragOver"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ========================================================= -->
        <!-- MODERN SLEEK SCROLLBAR (Firefox Dev Edition / macOS Style)-->
        <!-- ========================================================= -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="{StaticResource MintBorderStrongBrush}"
                                CornerRadius="3"
                                Margin="2,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource MintTextTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource MintAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Horizontal scrollbars need Height (not Width) and a non-reversed track -->
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================= -->
        <!-- UNIFIED ICON BUTTON STYLE (All nav/toolbar/action buttons)     -->
        <!-- Scale micro-animation on hover & press — one consistent style  -->
        <!-- ============================================================= -->
        <Style x:Key="ModernNavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#C8C8D4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" CornerRadius="{StaticResource MintRadiusM}" SnapsToDevicePixels="False">
                            <Border.Background>
                                <SolidColorBrush x:Name="BgBrush" Color="#00FFFFFF"/>
                            </Border.Background>
                            <ContentPresenter x:Name="BtnContent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color"
                                                            To="{StaticResource MintHoverOverlayColor}" Duration="0:0:0.12">
                                                <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color"
                                                            To="#00FFFFFF" Duration="0:0:0.09">
                                                <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                                <Setter Property="Foreground" Value="{StaticResource MintTextBrush}"/>
                                <Setter TargetName="BtnContent" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BtnContent" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tint laid over the wallpaper behind the tab bar + toolbar. This is only the default (dark wallpaper) value:
             the code-behind (UpdateChromeTint) replaces it at runtime, darker for bright wallpapers, so the icons stay visible. -->
        <LinearGradientBrush x:Key="ChromeTintBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#59000000" Offset="0"/><GradientStop Color="#1A000000" Offset="1"/></LinearGradientBrush>

        <!-- Tab pill: soft frosted-glass fill (wallpaper shows through), hairline white outline. -->
        <SolidColorBrush x:Key="TabPillFillBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="TabPillBorderBrush" Color="#40FFFFFF"/>

        <!-- Firefox-style tooltip: near-black, thin light outline, small radius -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource MintSurfaceFieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MintTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MintBorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Firefox-Style Round New Tab (+) Button -->
        <Style x:Key="NewTabButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernNavBtnStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <!-- Window Caption Controls -->
        <Style x:Key="WindowCaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MintHoverOverlayBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MintTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowCaptionButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="{StaticResource MintTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Firefox Tab Close Button (unified with ModernNavBtnStyle) -->
        <Style x:Key="TabCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernNavBtnStyle}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="#A0A0B0"/>
        </Style>

        <!-- Rendered once to a GPU texture and just rotated (2x so it stays crisp on high-DPI screens). -->
        <BitmapCache x:Key="SpinnerBitmapCache" RenderAtScale="2"/>

        <!-- Chrome/Firefox-like Tab Loading Spinner. The animation runs ONLY while the spinner is visible (it used to run
             forever on every tab, even collapsed ones, keeping the UI thread busy and making everything feel less smooth). -->
        <Style x:Key="TabSpinnerStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Width="14" Height="14" RenderTransformOrigin="0.5,0.5" CacheMode="{StaticResource SpinnerBitmapCache}">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SpinRotate" Angle="0"/>
                            </Grid.RenderTransform>
                            <Ellipse Stroke="#2BFFFFFF" StrokeThickness="2" Width="13" Height="13"/>
                            <Path Data="M 6.5,0 A 6.5,6.5 0 0 1 13,6.5" Stroke="{StaticResource MintAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinStory">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SpinRotate" Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinStory"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Loading Progress Bar (Professional Browser style). Sweeps only while visible; the code-behind fades it in / out. -->
        <Style x:Key="TopLoadingProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="2.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#15FFFFFF" Height="2.5">
                            <Grid ClipToBounds="True">
                                <Rectangle Width="260" Height="2.5" HorizontalAlignment="Left">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FAFAFA" Offset="0"/>
                                            <GradientStop Color="#FAFAFA" Offset="0.4"/>
                                            <GradientStop Color="#D1D1D1" Offset="0.8"/>
                                            <GradientStop Color="#00D1D1D1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="SweepShift" X="-260"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="SweepStory">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SweepShift" Storyboard.TargetProperty="X"
                                                             From="-260" To="2400" Duration="0:0:1.6" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SweepStory"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Firefox Developer Edition-style tab: translucent glass pill; the SELECTED tab is a dark glass capsule with a subtle outline.
             Inactive tabs are transparent, showing a frosted hover capsule on mouse-over. -->
        <Style x:Key="FirefoxTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <EventSetter Event="MouseEnter" Handler="TabItem_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="TabItem_MouseLeave"/>
            <EventSetter Event="PreviewMouseDown" Handler="TabItem_PreviewMouseDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- The outer Grid is the tab's hit surface and fills the whole strip height, so the 6px above and
                             below the visible pill belong to the tab too (click = select, drag = reorder / tear off).
                             IsHitTestVisibleInChrome keeps the window caption from claiming those pixels as title bar. -->
                        <Grid x:Name="TabHitSurface" Background="Transparent" VerticalAlignment="Stretch"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border x:Name="TabBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Margin="0,6"
                                    VerticalAlignment="Stretch"
                                    Width="{Binding DataContext.TabWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    Padding="10,0,8,0"
                                    SnapsToDevicePixels="False">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Image x:Name="TabFaviconImage"
                                               Source="{Binding Favicon}"
                                               Width="16" Height="16"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <ProgressBar x:Name="TabSpinner"
                                                     IsIndeterminate="True"
                                                     Width="14" Height="14"
                                                     Visibility="Collapsed"
                                                     Style="{StaticResource TabSpinnerStyle}"/>
                                    </Grid>

                                    <TextBlock x:Name="TabText" Grid.Column="1"
                                               Text="{Binding Title}"
                                               Foreground="{StaticResource MintTextSoftBrush}"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <Button x:Name="CloseBtn" Grid.Column="2"
                                            Visibility="Collapsed"
                                            Click="BtnCloseTab_Click"
                                            Style="{StaticResource TabCloseButtonStyle}"
                                            Tag="{Binding}"
                                            ToolTip="Close Tab (Ctrl+W)">
                                        <!-- ✕ icon (x cross) -->
                                        <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="9" Height="9" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Selected: translucent dark glass pill + subtle outline, white text -->
                            <DataTrigger Binding="{Binding DataContext.ShowCloseOnAllTabs, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CloseBtn" Property="Foreground" Value="{StaticResource MintTextBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource TabPillFillBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource TabPillBorderBrush}"/>
                                <Setter TargetName="TabText" Property="Foreground" Value="{StaticResource MintTextBrush}"/>
                                <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- Loading indicator in tab header -->
                            <DataTrigger Binding="{Binding ShowSpinner}" Value="True">
                                <Setter TargetName="TabFaviconImage" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="TabSpinner" Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                            <!-- Inactive tab hover: frosted glass capsule -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource MintHoverOverlayBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="TabText" Property="Foreground" Value="{StaticResource MintTextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row in the "List all tabs" dropdown -->
        <Style x:Key="AllTabsItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,1"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="AllTabsItem_Click"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Height="34" CornerRadius="{StaticResource MintRadiusM}" Padding="10,0" Background="Transparent" SnapsToDevicePixels="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Favicon}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource MintTextBrush}" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource MintSurfaceRaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource MintBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chrome-like rich omnibox suggestion row -->
        <!-- Firefox Dev Edition Style Omnibox Suggestion Row -->
        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SuggestionRow"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="10,6"
                                Height="36">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Favicon / Badge -->
                                <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Image x:Name="SuggestionImage"
                                           Source="{Binding CachedIcon}"
                                           Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="Collapsed"/>
                                    <TextBlock x:Name="SuggestionGlyph"
                                               Text="{Binding IconGlyph}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{StaticResource MintTextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Title • Domain inline like Firefox -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{StaticResource MintTextBrush}"
                                               FontSize="12.5"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="450"/>
                                    <TextBlock Text=" • " Foreground="#5F606A" FontSize="11" VerticalAlignment="Center" Margin="2,0"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="{StaticResource MintAccentBrush}"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Trailing Action / Switch Badge -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TrailingText}"
                                           Foreground="{StaticResource MintTextMutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SuggestionRow" Property="Background" Value="{StaticResource MintHoverOverlayBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SuggestionRow" Property="Background" Value="{StaticResource MintSelectedOverlayBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding CachedIcon, Converter={x:Static local:NullToBoolConverter.Instance}}" Value="True">
                                <Setter TargetName="SuggestionImage" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SuggestionGlyph" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionPopupBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MintSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MintBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="False"/>
        </Style>

        <!-- Sidebar Button Styles (Firefox Dev Edition) -->
        <Style x:Key="SidebarHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource MintHoverOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource MintHoverOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MintTextMutedBrush}"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#35FF4B4B"/>
                                <Setter Property="Foreground" Value="{StaticResource MintDangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchSelectorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource MintRadiusL}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource MintHoverOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Address Bar TextBox Style (Firefox Dev Edition Aligned) -->
        <Style x:Key="AddressBarTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MintTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource MintAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid VerticalAlignment="Center" Margin="6,0,0,0">
                            <!-- Watermark matches exact position, and hides when focused (Firefox behavior) -->
                            <TextBlock x:Name="Watermark" 
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, FallbackValue='Search with Google or enter address'}" 
                                       Foreground="{StaticResource MintTextMutedBrush}"
                                       FontSize="{TemplateBinding FontSize}" 
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       TextTrimming="CharacterEllipsis" 
                                       IsHitTestVisible="False" 
                                       Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsKeyboardFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab Bar Container (the empty space right of the tabs is the window drag area) -->
        <Border x:Name="TabBarBorder" Grid.Row="0" Background="{DynamicResource ChromeTintBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="TabStripHost" Grid.Column="0" Margin="6,0,0,0" SizeChanged="TabStripHost_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="TabListBox"
                             Grid.Column="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Focusable="False"
                             IsTabStop="False"
                             ItemsSource="{Binding Tabs}"
                             SelectionChanged="TabListBox_SelectionChanged"
                             PreviewMouseLeftButtonDown="TabListBox_PreviewMouseLeftButtonDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseUp="TabListBox_PreviewMouseUp"
                             PreviewMouseWheel="TabListBox_PreviewMouseWheel"
                             ItemContainerStyle="{StaticResource FirefoxTabItemStyle}"
                             VerticalAlignment="Stretch"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!-- Round New Tab (+) Button -->
                    <Button x:Name="BtnNewTab"
                             Grid.Column="1"
                             Click="BtnNewTab_Click"
                             Style="{StaticResource NewTabButtonStyle}"
                             ToolTip="Open a new tab (Ctrl+T)"
                             VerticalAlignment="Center">
                        <!-- Plus icon -->
                        <Path Data="M 12,5 L 12,19 M 5,12 L 19,12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- List all tabs (always reachable, even when the strip is full and scrolling) -->
                    <Button x:Name="BtnAllTabs"
                             Grid.Column="3"
                             Click="BtnAllTabs_Click"
                             Style="{StaticResource NewTabButtonStyle}"
                             Margin="4,0,4,0"
                             ToolTip="List all tabs"
                             VerticalAlignment="Center">
                        <!-- Chevron down icon -->
                        <Path Data="M 5,9 L 12,16 L 19,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="11" Height="9" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Window Caption Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Content="&#xE921;" Style="{StaticResource WindowCaptionButton}" ToolTip="Minimize"/>
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Content="&#xE922;" Style="{StaticResource WindowCaptionButton}" ToolTip="Maximize"/>
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Content="&#xE8BB;" Style="{StaticResource CloseWindowCaptionButton}" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource ChromeTintBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <!-- Back -->
                    <Button x:Name="BtnBack" Click="BtnBack_Click" Style="{StaticResource ModernNavBtnStyle}" ToolTip="Go back one page (Alt+Left Arrow)" IsEnabled="False">
                        <Path Data="M 11,4 L 3,12 L 11,20 M 3,12 L 21,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <!-- Forward -->
                    <Button x:Name="BtnForward" Click="BtnForward_Click" Style="{StaticResource ModernNavBtnStyle}" ToolTip="Go forward one page (Alt+Right Arrow)" IsEnabled="False">
                        <Path Data="M 13,4 L 21,12 L 13,20 M 21,12 L 3,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <!-- Reload / Stop -->
                    <Button x:Name="BtnReload" Click="BtnReload_Click" Style="{StaticResource ModernNavBtnStyle}" ToolTip="Reload current page (Ctrl+R)">
                        <!-- Reload / Stop icon. Drawn on a fixed 24x24 canvas inside a Viewbox so it is always centred and
                             never distorted by the path's own bounding box. PathReloadIcon.Data is swapped between reload and stop from code-behind. -->
                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="ReloadRotate" Angle="0"/>
                                </Canvas.RenderTransform>
                                <Path x:Name="PathReloadIcon"
                                      Data="M 20.91,13.25 A 9,9 0 1 1 12,3 C 14.52,3 16.93,4 18.74,5.74 L 21,8 M 21,3 L 21,8 L 16,8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <Grid x:Name="AddressBarHost" Grid.Column="1" Margin="8,4" SizeChanged="AddressBarHost_SizeChanged">
                    <Border x:Name="AddressBarOuterBorder" Background="Transparent" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="{StaticResource MintRadiusPill}" Height="32">
                        <!-- Transparent field (wallpaper + adaptive scrim show through). Looks the same whether or not it has focus. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Slot: Engine Selector or Active Pill -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,2,0">
                                <!-- Default Search Engine Selector Pill -->
                                <Button x:Name="BtnSearchEngineSelector" Click="BtnSearchEngineSelector_Click"
                                        Style="{StaticResource SearchSelectorButtonStyle}"
                                        VerticalAlignment="Center" ToolTip="Search engine &amp; shortcuts">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                        <Image x:Name="ImgDefaultEngine" Source="{x:Static local:EngineIcons.Google}" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="7.5" Foreground="{StaticResource MintTextMutedBrush}" Margin="4,2,2,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Active Search Engine / Filter Pill (Firefox Dev Edition style) -->
                                <!-- Active Search Engine Pill -->
                                <Border x:Name="ActiveEnginePill" Visibility="Collapsed"
                                        Background="{StaticResource MintSurfaceRaisedBrush}" BorderBrush="{StaticResource MintBorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource MintRadiusL}"
                                        VerticalAlignment="Center" Margin="2,0,4,0" Padding="7,2,5,2" Height="24">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image x:Name="ImgActiveEngine" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="TxtActiveEngineName" Text="Bing" Foreground="{StaticResource MintTextBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Button x:Name="BtnClearActiveEngine" Click="BtnClearActiveEngine_Click"
                                                Background="Transparent" BorderThickness="0" Width="14" Height="14"
                                                Cursor="Hand" ToolTip="Clear search engine" VerticalAlignment="Center"
                                                FocusVisualStyle="{x:Null}">
                                            <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                                  Stroke="{StaticResource MintTextMutedBrush}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="8" Height="8" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Center Slot: Address/Search input -->
                            <TextBox x:Name="TxtAddressBar"
                                     Grid.Column="1"
                                     Tag="Search with Google or enter address"
                                     TextChanged="TxtAddressBar_TextChanged"
                                     PreviewKeyDown="TxtAddressBar_PreviewKeyDown"
                                     GotKeyboardFocus="TxtAddressBar_GotKeyboardFocus"
                                     LostKeyboardFocus="TxtAddressBar_LostKeyboardFocus"
                                     PreviewMouseLeftButtonDown="TxtAddressBar_PreviewMouseLeftButtonDown"
                                     Style="{StaticResource AddressBarTextBox}"/>
                            <!-- Display-only overlay: same position/font as the TextBox text. Code-behind (UpdateAddressBarDisplay) fills it
                                 and hides the TextBox's own text while it is showing. Click-through, so the TextBox still gets the click. -->
                            <TextBlock x:Name="AddressBarDisplay" Grid.Column="1"
                                       Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"
                                       TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed"/>

                            <!-- Right Slot: Action Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                <!-- Bookmark / Star -->
                                <Button x:Name="BtnBookmark" Click="BtnBookmark_Click" Style="{StaticResource ModernNavBtnStyle}" Width="28" Height="28" ToolTip="Bookmark this tab (Ctrl+D)">
                                    <Path x:Name="PathBookmarkStar"
                                          Data="M 12,2 L 15.09,8.26 L 22,9.27 L 17,14.14 L 18.18,21.02 L 12,17.77 L 5.82,21.02 L 7,14.14 L 2,9.27 L 8.91,8.26 Z"
                                          Stroke="{StaticResource MintTextSoftBrush}" Fill="Transparent" StrokeThickness="1.5" StrokeLineJoin="Round"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                                <!-- Go / Enter arrow -->
                                <Button x:Name="BtnGo" Click="BtnGo_Click" Style="{StaticResource ModernNavBtnStyle}" Width="28" Height="28" ToolTip="Go / Search">
                                    <Path Data="M 5,12 L 19,12 M 13,6 L 19,12 L 13,18"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right toolbar: secondary actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- History / Sidebar toggle -->
                    <Button x:Name="BtnHistory" Click="BtnHistory_Click" Style="{StaticResource ModernNavBtnStyle}" ToolTip="Sidebar / History (Ctrl+H)">
                        <!-- History icon: clock face with a counter-clockwise arrow (24x24 canvas in a Viewbox,
                             same technique as the reload icon so size and stroke match the other toolbar icons). -->
                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 3,12 A 9,9 0 1 0 12,3 A 9.75,9.75 0 0 0 5.26,5.74 L 3,8 M 3,3 L 3,8 L 8,8 M 12,7 L 12,12 L 16,14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Wallpaper / Theme -->
                    <Button x:Name="BtnWallpaper" Click="BtnWallpaper_Click" Style="{StaticResource ModernNavBtnStyle}" ToolTip="Customize Wallpaper">
                        <Path Data="M 3,3 L 21,3 L 21,21 L 3,21 Z M 3,15 L 7,11 L 11,15 L 15,9 L 21,15"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <!-- Extensions manager (mint://extensions) -->
                    <Button x:Name="BtnUBlock" Click="BtnUBlock_Click" Style="{StaticResource ModernNavBtnStyle}" ToolTip="Extensions">
                        <Path Data="M 19.439 7.85 c -0.049 0.322 0.059 0.648 0.289 0.878 l 1.568 1.568 c 0.47 0.47 0.706 1.087 0.706 1.704 s -0.235 1.233 -0.706 1.704 l -1.611 1.611 a 0.98 0.98 0 0 1 -0.837 0.276 c -0.47 -0.07 -0.802 -0.48 -0.968 -0.925 a 2.501 2.501 0 1 0 -3.214 3.214 c 0.446 0.166 0.855 0.497 0.925 0.968 a 0.979 0.979 0 0 1 -0.276 0.837 l -1.61 1.61 a 2.404 2.404 0 0 1 -1.705 0.707 a 2.402 2.402 0 0 1 -1.704 -0.706 l -1.568 -1.568 a 1.026 1.026 0 0 0 -0.877 -0.29 c -0.493 0.074 -0.84 0.504 -1.02 0.968 a 2.5 2.5 0 1 1 -3.237 -3.237 c 0.464 -0.18 0.894 -0.527 0.967 -1.02 a 1.026 1.026 0 0 0 -0.289 -0.877 l -1.568 -1.568 A 2.402 2.402 0 0 1 1.998 12 c 0 -0.617 0.236 -1.234 0.706 -1.704 L 4.23 8.77 c 0.24 -0.24 0.581 -0.353 0.917 -0.303 c 0.515 0.077 0.877 0.528 1.073 1.01 a 2.5 2.5 0 1 0 3.259 -3.259 c -0.482 -0.196 -0.933 -0.558 -1.01 -1.073 c -0.05 -0.336 0.062 -0.676 0.303 -0.917 l 1.525 -1.525 A 2.402 2.402 0 0 1 12 1.998 c 0.617 0 1.234 0.236 1.704 0.706 l 1.568 1.568 c 0.23 0.23 0.556 0.338 0.877 0.29 c 0.493 -0.074 0.84 -0.504 1.02 -0.968 a 2.5 2.5 0 1 1 3.237 3.237 c -0.464 0.18 -0.894 0.527 -0.967 1.02 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <!-- Site video download (yt-dlp): YouTube, Facebook, Instagram, X, TikTok, Vimeo ... -->
                    <Button x:Name="BtnYtdl" Click="BtnYtdl_Click" Style="{StaticResource ModernNavBtnStyle}" ToolTip="Download video / audio from this site" Visibility="Collapsed">
                        <Path Data="M 12,3 A 9,9 0 1 0 12,21 A 9,9 0 1 0 12,3 M 12,8 L 12,15 M 8.5,12 L 12,15.5 L 15.5,12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <!-- Page media (IDM style): visible while the page loads video / audio -->
                    <Button x:Name="BtnStreams" Click="BtnStreams_Click" Style="{StaticResource ModernNavBtnStyle}" ToolTip="Download video / audio from this page" Visibility="Collapsed">
                        <Grid>
                            <Path Data="M 4,4 L 20,4 L 20,14 L 4,14 Z M 10,6.5 L 14,9 L 10,11.5 Z M 12,16.5 L 12,21 M 9.5,18.5 L 12,21 L 14.5,18.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                            <Border Background="{StaticResource MintAccentBrush}" CornerRadius="6" MinWidth="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-7,0" Padding="2,0,2,0">
                                <TextBlock x:Name="StreamsBadgeText" Text="1" Foreground="{StaticResource MintTextOnAccentBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <!-- Downloads -->
                    <Button x:Name="BtnDownloadsManager" Click="BtnDownloadsManager_Click" Style="{StaticResource ModernNavBtnStyle}" ToolTip="Downloads">
                        <Path Data="M 12,3 L 12,15 M 8,11 L 12,15 L 16,11 M 4,20 L 20,20"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Area: Left Docked Sidebar + Resizer + Main WebView Area -->
        <Grid Grid.Row="2" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto" MinWidth="0"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Firefox Developer Edition Docked Sidebar Panel -->
            <Border x:Name="SidebarPanel" Grid.Column="0" MinWidth="240" MaxWidth="600" Background="{StaticResource MintSurfaceBrush}" BorderBrush="{StaticResource MintSeparatorBrush}" BorderThickness="0,0,1,0" Visibility="Collapsed">
                <Grid Margin="12,10,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Search & Sort -->
                        <RowDefinition Height="*"/>    <!-- Content List -->
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header: Switcher Dropdown Button & Close Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Button x:Name="BtnSidebarViewSwitcher" Click="BtnSidebarViewSwitcher_Click" Style="{StaticResource SidebarHeaderButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtSidebarTitle" Text="History" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource MintTextBrush}"/>
                                <!-- Chevron down -->
                                <Path Data="M 5,9 L 12,16 L 19,9"
                                      Stroke="{StaticResource MintTextMutedBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="9" Height="7" Stretch="Uniform" Margin="6,1,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- View Switcher Dropdown Popup -->
                        <Popup x:Name="SidebarViewPopup" PlacementTarget="{Binding ElementName=BtnSidebarViewSwitcher}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                            <Border Background="{StaticResource MintSurfaceRaisedBrush}" BorderBrush="{StaticResource MintBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource MintRadiusM}" Padding="4" Width="210">
                                <StackPanel>
                                    <Button x:Name="BtnSelectBookmarks" Click="BtnSelectBookmarks_Click" Style="{StaticResource SidebarMenuItemStyle}">
                                        <Grid Width="190">
                                            <TextBlock Text="Bookmarks" Foreground="{StaticResource MintTextBrush}" FontSize="12.5" Margin="4,0,0,0"/>
                                            <!-- Bookmark icon -->
                                            <Path Data="M 5,2 L 19,2 L 19,22 L 12,17 L 5,22 Z"
                                                  Stroke="{StaticResource MintTextMutedBrush}" StrokeThickness="1.5" Fill="Transparent"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="11" Height="12" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="BtnSelectHistory" Click="BtnSelectHistory_Click" Style="{StaticResource SidebarMenuItemStyle}">
                                        <Grid Width="190">
                                            <TextBlock Text="History" Foreground="{StaticResource MintTextBrush}" FontSize="12.5" Margin="4,0,0,0"/>
                                            <!-- History icon (clock + counter-clockwise arrow), 24x24 canvas in a Viewbox -->
                                            <Viewbox Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,6,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 3,12 A 9,9 0 1 0 12,3 A 9.75,9.75 0 0 0 5.26,5.74 L 3,8 M 3,3 L 3,8 L 8,8 M 12,7 L 12,12 L 16,14"
                                                          Stroke="{StaticResource MintTextMutedBrush}" StrokeThickness="2.2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="BtnSelectPasswords" Click="BtnSelectPasswords_Click" Style="{StaticResource SidebarMenuItemStyle}">
                                        <Grid Width="190">
                                            <TextBlock Text="Passwords" Foreground="{StaticResource MintTextBrush}" FontSize="12.5" Margin="4,0,0,0"/>
                                            <!-- Padlock icon -->
                                            <Path Data="M 5,11 L 19,11 L 19,22 L 5,22 Z M 8,11 L 8,7 A 4,4 0 0 1 16,7 L 16,11"
                                                  Stroke="{StaticResource MintTextMutedBrush}" StrokeThickness="1.5" Fill="Transparent"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="11" Height="12" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Button x:Name="BtnSidebarOpenFullPage" Click="BtnSidebarOpenFullPage_Click" Style="{StaticResource ModernNavBtnStyle}" HorizontalAlignment="Right" Width="26" Height="26" Margin="0,0,30,0" ToolTip="Open as a full page (manage, select and delete in bulk)">
                            <Path Data="M 14,4 L 20,4 L 20,10 M 20,4 L 11,13 M 18,14 L 18,19 A 1,1 0 0 1 17,20 L 5,20 A 1,1 0 0 1 4,19 L 4,7 A 1,1 0 0 1 5,6 L 10,6"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnCloseSidebar" Click="BtnCloseSidebar_Click" Style="{StaticResource ModernNavBtnStyle}" HorizontalAlignment="Right" Width="26" Height="26" ToolTip="Close sidebar">
                            <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Search & More Options Row -->
                    <Grid x:Name="SidebarSearchRow" Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Firefox-Style Unified Search Box with Watermark -->
                        <Border Background="{StaticResource MintSurfaceRaisedBrush}" BorderBrush="{StaticResource MintBorderBrush}" BorderThickness="1" CornerRadius="6" Height="30">
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Search icon (magnifier) -->
                                <Path Data="M 21,21 L 15,15 M 10,17 A 7,7 0 1,0 10,3 A 7,7 0 0,0 10,17 Z"
                                      Stroke="{StaticResource MintTextMutedBrush}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSidebarSearchWatermark" Text="Search history" Foreground="{StaticResource MintTextMutedBrush}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="TxtSidebarSearch" Background="Transparent" Foreground="{StaticResource MintTextBrush}" BorderThickness="0"
                                             VerticalAlignment="Center" FontSize="12" TextChanged="TxtSidebarSearch_TextChanged" VerticalContentAlignment="Center"
                                             CaretBrush="{StaticResource MintAccentBrush}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ⋯ More Options Button -->
                        <Button x:Name="BtnSidebarMoreOptions" Grid.Column="1" Click="BtnSidebarMoreOptions_Click"
                                Style="{StaticResource ModernNavBtnStyle}" Width="28" Height="28" Margin="6,0,0,0" ToolTip="View options">
                            <!-- 3 dot ellipsis icon -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="3.5" Height="3.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Ellipse Width="3.5" Height="3.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="2.5,0"/>
                                <Ellipse Width="3.5" Height="3.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>

                        <!-- Sort Options Popup -->
                        <Popup x:Name="SidebarSortPopup" PlacementTarget="{Binding ElementName=BtnSidebarMoreOptions}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                            <Border Background="{StaticResource MintSurfaceRaisedBrush}" BorderBrush="{StaticResource MintBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource MintRadiusM}" Padding="6" Width="190">
                                <StackPanel>
                                    <TextBlock Text="Sort by:" Foreground="{StaticResource MintTextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="6,2,6,4"/>
                                    <Button x:Name="BtnSortByDate" Click="BtnSortByDate_Click" Style="{StaticResource SidebarMenuItemStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas Width="14" Height="14" Margin="0,0,8,0">
                                                <Path x:Name="CheckSortDate"
                                                      Data="M 2,7 L 6,11 L 12,3"
                                                      Stroke="{StaticResource MintSuccessBrush}" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="10" Height="9" Stretch="Uniform" Canvas.Left="2" Canvas.Top="2.5"/>
                                            </Canvas>
                                            <TextBlock Text="Date" Foreground="{StaticResource MintTextBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnSortBySite" Click="BtnSortBySite_Click" Style="{StaticResource SidebarMenuItemStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas Width="14" Height="14" Margin="0,0,8,0">
                                                <Path x:Name="CheckSortSite"
                                                      Data="M 2,7 L 6,11 L 12,3"
                                                      Stroke="{StaticResource MintSuccessBrush}" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="10" Height="9" Stretch="Uniform" Canvas.Left="2" Canvas.Top="2.5"
                                                      Visibility="Collapsed"/>
                                            </Canvas>
                                            <TextBlock Text="Site" Foreground="{StaticResource MintTextBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnSortByLastVisited" Click="BtnSortByLastVisited_Click" Style="{StaticResource SidebarMenuItemStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas Width="14" Height="14" Margin="0,0,8,0">
                                                <Path x:Name="CheckSortLastVisited"
                                                      Data="M 2,7 L 6,11 L 12,3"
                                                      Stroke="{StaticResource MintSuccessBrush}" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="10" Height="9" Stretch="Uniform" Canvas.Left="2" Canvas.Top="2.5"
                                                      Visibility="Collapsed"/>
                                            </Canvas>
                                            <TextBlock Text="Last visited" Foreground="{StaticResource MintTextBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnSortByMostVisited" Click="BtnSortByMostVisited_Click" Style="{StaticResource SidebarMenuItemStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas Width="14" Height="14" Margin="0,0,8,0">
                                                <Path x:Name="CheckSortMostVisited"
                                                      Data="M 2,7 L 6,11 L 12,3"
                                                      Stroke="{StaticResource MintSuccessBrush}" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="10" Height="9" Stretch="Uniform" Canvas.Left="2" Canvas.Top="2.5"
                                                      Visibility="Collapsed"/>
                                            </Canvas>
                                            <TextBlock Text="Most visited" Foreground="{StaticResource MintTextBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Height="1" Background="{StaticResource MintBorderBrush}" Margin="4,4"/>
                                    <Button x:Name="BtnClearSidebarHistory" Click="BtnClearSidebarHistory_Click" Style="{StaticResource SidebarMenuItemStyle}">
                                        <TextBlock Text="Clear history" Foreground="{StaticResource MintDangerBrush}" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Content Views: Grouped History -->
                    <ScrollViewer x:Name="SidebarHistoryScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SidebarHistoryGroupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <!-- Group header: click anywhere on it to collapse / expand the group -->
                                        <Border x:Name="GroupHeaderBorder" Background="Transparent" CornerRadius="6" Padding="4,3" Margin="0,0,0,2"
                                                Cursor="Hand" MouseLeftButtonDown="HistoryGroupHeader_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <!-- Chevron: points right when collapsed, rotates down when expanded -->
                                                    <Path x:Name="GroupChevron" Data="M 8,5 L 15,12 L 8,19"
                                                          Stroke="{StaticResource MintTextMutedBrush}" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="6" Height="9" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="90"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                                <TextBlock Text="{Binding Header}" Foreground="{StaticResource MintTextMutedBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="HistoryRowBorder" Background="Transparent" CornerRadius="6" Padding="6,4" Margin="0,1" Cursor="Hand" MouseLeftButtonDown="SidebarHistoryItem_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Source="{Binding FaviconUrl}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource MintTextBrush}" FontSize="12" Margin="6,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Button x:Name="BtnDeleteHistoryRow" Grid.Column="2" Click="BtnDeleteHistoryRow_Click" Tag="{Binding Url}" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SidebarDeleteButtonStyle}" Width="22" Height="22" ToolTip="Delete from history"/>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger Property="Border.IsMouseOver" Value="True">
                                                            <Setter TargetName="HistoryRowBorder" Property="Background" Value="{StaticResource MintHoverOverlayBrush}"/>
                                                            <Setter TargetName="BtnDeleteHistoryRow" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="GroupHeaderBorder" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="GroupHeaderBorder" Property="Background" Value="{StaticResource MintHoverOverlayBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="GroupChevron"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         To="0" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="GroupChevron"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         To="90" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Content Views: Passwords (WebView2 keeps saved logins in the profile; it only allows removing all of them) -->
                    <StackPanel x:Name="SidebarPasswordsPanel" Grid.Row="2" Visibility="Collapsed" Margin="2,4,2,0">
                        <TextBlock Text="Saved passwords" Foreground="{StaticResource MintTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MintTextMutedBrush}" FontSize="12" Margin="0,6,0,0"
                                   Text="Mint Browser saves logins in its own profile, separate from Edge. The browser engine offers no way to list or edit single logins, so the only management available here is removing all of them."/>
                        <Button x:Name="BtnClearSavedPasswords" Click="BtnClearSavedPasswords_Click" Style="{StaticResource SidebarMenuItemStyle}"
                                Background="{StaticResource MintSurfaceRaisedBrush}" Padding="10,8" Margin="0,14,0,0">
                            <TextBlock Text="Clear saved passwords&#x2026;" Foreground="{StaticResource MintDangerBrush}" FontSize="12.5"/>
                        </Button>
                        <TextBlock x:Name="TxtPasswordsStatus" TextWrapping="Wrap" Foreground="{StaticResource MintTextMutedBrush}" FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Content Views: Bookmarks -->
                    <ScrollViewer x:Name="SidebarBookmarksScroll" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SidebarBookmarksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="BmkRowBorder" Background="Transparent" CornerRadius="6" Padding="6,5" Margin="0,1" Cursor="Hand" MouseLeftButtonDown="SidebarBookmarkItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding FaviconUrl}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource MintTextBrush}" FontSize="12" Margin="6,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button x:Name="BtnDeleteBmkRow" Grid.Column="2" Click="BtnDeleteBookmarkRow_Click" Tag="{Binding Url}" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SidebarDeleteButtonStyle}" Width="22" Height="22" ToolTip="Remove bookmark"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="Border.IsMouseOver" Value="True">
                                            <Setter TargetName="BmkRowBorder" Property="Background" Value="{StaticResource MintHoverOverlayBrush}"/>
                                            <Setter TargetName="BtnDeleteBmkRow" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Modern Firefox Sidebar Resizer Splitter -->
            <GridSplitter x:Name="SidebarResizer" Grid.Column="1" Width="3" Background="{StaticResource MintSurfaceRaisedBrush}" HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" ShowsPreview="False" Cursor="SizeWE" Visibility="Collapsed" Focusable="False"/>

            <!-- Main WebView Area -->
            <Grid x:Name="TabContentGrid" Grid.Column="2" Background="Transparent"/>
        </Grid>

        <!-- Top Loading Progress Bar (Professional Browser style) -->
        <ProgressBar x:Name="TopProgressBar"
                     Grid.Row="2"
                     Height="2.5"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     Visibility="Collapsed"
                     Style="{StaticResource TopLoadingProgressBarStyle}"/>

        <!-- Cross-window tab drop target highlight -->
        <Border x:Name="TabDropIndicator"
                Grid.Row="0"
                Margin="4,3"
                CornerRadius="{StaticResource MintRadiusM}"
                BorderBrush="{StaticResource MintAccentBrush}"
                BorderThickness="1.5"
                Background="{StaticResource MintAccentSoftBrush}"
                Opacity="0"
                IsHitTestVisible="False"/>

        <!-- Rich address bar suggestions -->
        <Popup x:Name="AddressSuggestionsPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=AddressBarHost}"
               VerticalOffset="6"
               PopupAnimation="Fade"
               Opened="AddressSuggestionsPopup_Opened"
               Closed="AddressSuggestionsPopup_Closed">
            <Border x:Name="AddressSuggestionsBorder"
                    Width="480"
                    MaxHeight="420"
                    Padding="5"
                    Style="{StaticResource SuggestionPopupBorder}">
                <ListBox x:Name="AddressSuggestionsList"
                          ItemsSource="{Binding AddressSuggestions}"
                          ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          MaxHeight="408"
                          Focusable="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          MouseLeftButtonUp="AddressSuggestionsList_MouseLeftButtonUp"/>
            </Border>
        </Popup>

        <!-- "List all tabs" dropdown -->
        <Popup x:Name="AllTabsPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnAllTabs}"
               VerticalOffset="6"
               PopupAnimation="None">
            <Border Width="300" Padding="6" CornerRadius="{StaticResource MintRadiusL}"
                    Background="{StaticResource MintSurfaceBrush}" BorderBrush="{StaticResource MintBorderStrongBrush}" BorderThickness="1"
                    SnapsToDevicePixels="False">
                <ListBox x:Name="AllTabsList"
                         ItemsSource="{Binding Tabs}"
                         ItemContainerStyle="{StaticResource AllTabsItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MaxHeight="420"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Popup>

        <!-- Firefox-Style Bookmark Edit Popover -->
        <Popup x:Name="BookmarkEditPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnBookmark}"
               VerticalOffset="6"
               PopupAnimation="Fade">
            <Border Width="320" Padding="14" CornerRadius="{StaticResource MintRadiusL}"
                    Background="{StaticResource MintSurfaceRaisedBrush}" BorderBrush="{StaticResource MintBorderStrongBrush}" BorderThickness="1"
                    SnapsToDevicePixels="False">
                <StackPanel>
                    <TextBlock Text="Edit Bookmark" Foreground="{StaticResource MintTextBrush}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,10"/>

                    <TextBlock Text="Name" Foreground="{StaticResource MintTextMutedBrush}" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtBookmarkTitle" Height="30" Background="{StaticResource MintSurfaceInputBrush}" Foreground="{StaticResource MintTextBrush}" BorderBrush="{StaticResource MintBorderStrongBrush}"
                             BorderThickness="1" Padding="8,4" FontSize="12" Margin="0,0,0,8" VerticalContentAlignment="Center"
                             CaretBrush="{StaticResource MintAccentBrush}"/>

                    <TextBlock Text="Location" Foreground="{StaticResource MintTextMutedBrush}" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtBookmarkUrl" Height="30" Background="{StaticResource MintSurfaceBrush}" Foreground="{StaticResource MintTextMutedBrush}" BorderBrush="{StaticResource MintBorderBrush}"
                             BorderThickness="1" Padding="8,4" FontSize="11" Margin="0,0,0,14" IsReadOnly="True" VerticalContentAlignment="Center"/>
                    <!-- TxtBookmarkFolder kept in tree for code-behind compatibility but hidden -->
                    <TextBox x:Name="TxtBookmarkFolder" Visibility="Collapsed" Text="Bookmarks Toolbar"/>

                    <Grid>
                        <Button x:Name="BtnRemoveBookmark" Click="BtnRemoveBookmark_Click" Content="Remove"
                                Foreground="{StaticResource MintDangerBrush}" Style="{StaticResource MintButton}"
                                Background="Transparent" MinWidth="0" Height="30" Padding="10,0"/>
                        <Button x:Name="BtnSaveBookmark" Click="BtnSaveBookmark_Click" Content="Save" Width="68" Height="30"
                                Style="{StaticResource MintPrimaryButton}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Downloads dropdown (Chrome-style "Recent download history") -->
        <Popup x:Name="DownloadsPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnDownloadsManager}"
               VerticalOffset="6"
               PopupAnimation="Fade">
            <Border Width="340" CornerRadius="{StaticResource MintRadiusL}"
                    Background="{StaticResource MintSurfaceBrush}" BorderBrush="{StaticResource MintBorderStrongBrush}" BorderThickness="1"
                    SnapsToDevicePixels="False">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="16,12,10,4">
                        <TextBlock Text="Recent download history" Foreground="{StaticResource MintTextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="BtnCloseDownloadsPopup" Click="BtnCloseDownloadsPopup_Click"
                                Style="{StaticResource ModernNavBtnStyle}" Width="26" Height="26"
                                HorizontalAlignment="Right" ToolTip="Close">
                            <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Empty state -->
                    <TextBlock Text="No downloads yet" Foreground="{StaticResource MintTextMutedBrush}" FontSize="12" Margin="16,8,16,18">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=DownloadsItemsControl}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Download list (newest first) -->
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DownloadsItemsControl"
                                      ItemsSource="{x:Static svc:DownloadStore.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="{StaticResource MintRadiusM}"
                                            Margin="6,1" Padding="10,9" Cursor="Hand"
                                            ToolTip="{Binding SavePath}"
                                            MouseLeftButtonUp="DownloadRow_MouseLeftButtonUp">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- File icon: the real Windows icon (a finished program shows its own); the outlined sheet is only a fallback -->
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{StaticResource MintSurfaceInputBrush}"
                                                    BorderBrush="{StaticResource MintBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Path Data="M 7,3 L 14,3 L 18,7 L 18,21 L 7,21 Z M 14,3 L 14,7 L 18,7"
                                                          Stroke="{StaticResource MintTextSoftBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                                          Width="13" Height="15" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Grid>
                                            </Border>

                                            <!-- Name / progress / status -->
                                            <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource MintTextBrush}" FontSize="12.5"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4"
                                                             Margin="0,5,0,2" BorderThickness="0"
                                                             Foreground="{StaticResource MintAccentBrush}" Background="{StaticResource MintSurfaceRaisedBrush}">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource MintProgressBar}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowProgress}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MintTextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource MintDangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Show in folder (finished downloads only) -->
                                            <Button Grid.Column="2" Click="DownloadShowInFolder_Click"
                                                    Width="28" Height="28" VerticalAlignment="Center" ToolTip="Show in folder">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ModernNavBtnStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="M 3,6 L 9,6 L 11,8 L 21,8 L 21,19 L 3,19 Z"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.7" StrokeLineJoin="Round"
                                                      Width="14" Height="14" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource MintHoverOverlayBrush}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border BorderBrush="{StaticResource MintSeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0">
                        <Button Click="BtnFullDownloadHistory_Click" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="FooterBg" Background="Transparent" CornerRadius="0,0,11,11" Padding="16,12">
                                        <Grid>
                                            <TextBlock Text="Full download history" Foreground="{StaticResource MintTextBrush}" FontSize="12.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Path Data="M 14,4 L 20,4 L 20,10 M 20,4 L 10,14 M 18,14 L 18,20 L 4,20 L 4,6 L 10,6"
                                                  Stroke="{StaticResource MintTextSoftBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FooterBg" Property="Background" Value="{StaticResource MintHoverOverlayBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Tab hover card (title + domain, plus a page thumbnail for background tabs) -->
        <Popup x:Name="TabPreviewPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Relative"
               PopupAnimation="None">
            <Border Padding="12,10" CornerRadius="10"
                    Background="{StaticResource MintSurfaceBrush}" BorderBrush="{StaticResource MintBorderStrongBrush}" BorderThickness="1"
                    SnapsToDevicePixels="False" IsHitTestVisible="False">
                <StackPanel Width="230">
                    <TextBlock x:Name="PreviewTitle" Foreground="{StaticResource MintTextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PreviewDomain" Foreground="{StaticResource MintTextMutedBrush}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="PreviewImageHost" Margin="0,8,0,0" CornerRadius="6" ClipToBounds="True" Background="{StaticResource MintSurfaceRaisedBrush}">
                        <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="140" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Firefox Developer Edition Search Engine Dropdown -->
        <Popup x:Name="SearchEnginePopup"
               AllowsTransparency="True"
               StaysOpen="False"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnSearchEngineSelector}"
               VerticalOffset="6"
               PopupAnimation="Fade">
            <Border Width="240" Padding="6" CornerRadius="10"
                    Background="{StaticResource MintSurfaceRaisedBrush}" BorderBrush="{StaticResource MintBorderBrush}" BorderThickness="1"
                    SnapsToDevicePixels="False">
                <StackPanel>
                    <TextBlock Text="Search with:" Foreground="{StaticResource MintTextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="8,4,8,4"/>
                    <Button x:Name="BtnEngineGoogle" Click="BtnEngineGoogle_Click" Style="{StaticResource SidebarMenuItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static local:EngineIcons.Google}" Width="16" Height="16" Margin="4,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Google" Foreground="{StaticResource MintTextBrush}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnEngineBing" Click="BtnEngineBing_Click" Style="{StaticResource SidebarMenuItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static local:EngineIcons.Bing}" Width="16" Height="16" Margin="4,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Bing" Foreground="{StaticResource MintTextBrush}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnEngineDuckDuckGo" Click="BtnEngineDuckDuckGo_Click" Style="{StaticResource SidebarMenuItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static local:EngineIcons.DuckDuckGo}" Width="16" Height="16" Margin="4,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="DuckDuckGo" Foreground="{StaticResource MintTextBrush}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnEngineMDN" Click="BtnEngineMDN_Click" Style="{StaticResource SidebarMenuItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static local:EngineIcons.Mdn}" Width="16" Height="16" Margin="4,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="MDN Web Docs" Foreground="{StaticResource MintTextBrush}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnEnginePerplexity" Click="BtnEnginePerplexity_Click" Style="{StaticResource SidebarMenuItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static local:EngineIcons.Perplexity}" Width="16" Height="16" Margin="4,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Perplexity" Foreground="{StaticResource MintTextBrush}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnEngineWikipedia" Click="BtnEngineWikipedia_Click" Style="{StaticResource SidebarMenuItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static local:EngineIcons.Wikipedia}" Width="16" Height="16" Margin="4,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Wikipedia (en)" Foreground="{StaticResource MintTextBrush}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>


                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>


