<Window x:Class="CustomBrowser.Views.YtdlPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download video / audio" Width="608" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CustomBrowser;component/Themes/DialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The 24px margin leaves room for the soft shadow around the card -->
    <Border Margin="24" Background="{StaticResource MintSurfaceBrush}" BorderBrush="{StaticResource MintSeparatorBrush}" BorderThickness="1" CornerRadius="{StaticResource MintRadiusL}"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="24,22,24,0">
                <TextBlock Text="Download video / audio" Foreground="{StaticResource MintTextBrush}" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtPage" Foreground="{StaticResource MintTextMutedBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Login option (must be visible before the page is read: private videos cannot even be listed without it) -->
            <CheckBox x:Name="ChkCookies" Grid.Row="1" Margin="24,16,24,0" Style="{StaticResource DarkCheckBox}"
                      Checked="ChkCookies_Changed" Unchecked="ChkCookies_Changed">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MintTextSoftBrush}" FontSize="12.5"
                           Text="Use my browser login (for private, age-restricted or members-only videos)"/>
            </CheckBox>

            <!-- Body: either the status (reading / setup / error) or the options -->
            <Grid Grid.Row="2" Margin="24,0,24,0">
                <StackPanel x:Name="StatusPanel" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Foreground="{StaticResource MintTextSoftBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                    <ProgressBar x:Name="BarBusy" IsIndeterminate="True" Height="4" Foreground="{StaticResource MintAccentBrush}"
                                 Background="{StaticResource MintSurfaceRaisedBrush}" BorderThickness="0" Margin="40,14,40,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="BtnSetup" Content="Download yt-dlp" Style="{StaticResource MintPrimaryButton}"
                                Click="BtnSetup_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRetry" Content="Try again" Style="{StaticResource MintButton}"
                                Click="BtnRetry_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer x:Name="OptionsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,14,10,8">
                        <TextBlock x:Name="TxtVideoTitle" Foreground="{StaticResource MintTextBrush}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtMeta" Foreground="{StaticResource MintTextMutedBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="What to download" Style="{StaticResource FieldLabel}"/>
                        <ListBox x:Name="LstMode" Style="{StaticResource DarkListBox}"
                                 ItemContainerStyle="{StaticResource ChipItem}"
                                 SelectionChanged="LstMode_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <TextBlock Text="Quality" Style="{StaticResource FieldLabel}"/>
                        <ListBox x:Name="LstQuality" Style="{StaticResource DarkListBox}"
                                 ItemContainerStyle="{StaticResource RowItem}" MaxHeight="120"
                                 SelectionChanged="LstQuality_SelectionChanged"/>

                        <TextBlock x:Name="TxtNote" Foreground="{StaticResource MintWarningBrush}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="Collapsed"/>

                        <TextBlock Text="File name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource MintTextBox}"/>

                        <TextBlock Text="Save to" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFolder" Style="{StaticResource MintTextBox}"/>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse..." Style="{StaticResource MintButton}"
                                    Margin="8,0,0,0" Click="BtnBrowse_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="24,12,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtToolVersion" Foreground="{StaticResource MintTextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="BtnUpdate" Content="Update yt-dlp" Style="{StaticResource LinkButton}"
                            Click="BtnUpdate_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource MintButton}" IsCancel="True"
                            Margin="0,0,8,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnDownload" Content="Download" Style="{StaticResource MintPrimaryButton}" IsDefault="True"
                            IsEnabled="False" Click="BtnDownload_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>


