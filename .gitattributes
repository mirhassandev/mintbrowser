# Force consistent line endings for all text files checked into git.
# On Windows, git.exe may use CRLF in the working copy but always stores LF in the repo.
* text=auto eol=crlf

# Source files — always CRLF on checkout on Windows
*.cs      text eol=crlf
*.xaml    text eol=crlf
*.xml     text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.md      text eol=crlf
*.json    text eol=crlf
*.js      text eol=crlf
*.ts      text eol=crlf
*.css     text eol=crlf
*.html    text eol=crlf
*.ps1     text eol=crlf

# Shell scripts — LF only
*.sh text eol=lf

# Binaries — no line-ending conversion, no text diffing
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.exe   binary
*.dll   binary
*.pdb   binary
*.zip   binary
*.7z    binary

