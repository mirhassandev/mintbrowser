.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/
*.swp
*.swo
*~

# ─── Rider / ReSharper ────────────────────────────────────────────────────────
_ReSharper*/
*.DotSettings.user

# ─── OS noise ─────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride

